{% if oxcmp_categories %}
    {% set categoriesTilesWidth = theme.setting('showCategoryTilesWidth') %}
    {% set categoriesTilesGrid = theme.setting('showCategoryTilesGrid') %}
    {% set categoriesTilesBg = theme.setting('showCategoryTilesBg') %}
    {% set categoriesTilesSpacing = theme.setting('showCategoryTilesSpacing') %}
    {% set categoriesTilesRowPadding = theme.setting('showCategoryTilesRowPadding') %}

    {# TODO: We should turn this into vCMS content #}
    <div class="container-xxl row-spacer">
        <div class="categories">
            <span class="visually-hidden">{{ translate({ ident: "CATEGORIES" }) }}</span>
            {% set categories = oxcmp_categories %}
            {% macro render_categories(categories) %}
                {% for cat in categories %}
                    {% if not cat.getHasVisibleSubCats() %}
                        <a class="btn btn-sm btn-tag btn-rounded todo" href="{{ cat.getLink()|raw }}">
                            {{ cat.oxcategories__oxtitle.value }}
                        </a>
                    {% else %}
                        {{ _self.render_categories(cat.getSubCats()) }}
                    {% endif %}
                {% endfor %}
            {% endmacro %}

            <div class="category-list">
                {{ _self.render_categories(categories) }}
            </div>
        </div>
    </div>
{% endif %}