{% block dd_widget_header_categorylist %}

    {% if oxcmp_categories %}
        {% set homeNotSelected = oViewConf.getTopActionClassName() != 'start' %}

        <div class="container-xxl">
            <nav id="mainnav" class="navbar navbar-mega navbar-expand-lg p-0">
                {% block dd_widget_header_categorylist_navbar_mega_menu %}
                    <div class="navbar-collapse collapse align-items-start row" id="navbarSupportedContent">
                        <div id="navigation" class="navbar-nav navbar-nav-mega col-sm-12 col-md-6">
                            {% block dd_widget_header_categorylist_navbar_list_mega_menu %}
                                {% for catkey, ocat in oxcmp_categories %}
                                    {% if ocat.getIsVisible() %}
                                        {% for oTopCont in ocat.getContentCats() %}
                                            <div class="nav-item">
                                                <a class="nav-link nav-link-1{% if oContent.oxcontents__oxloadid.value is same as(oTopCont.oxcontents__oxloadid.value) %} active{% endif %}"{% if oContent.oxcontents__oxloadid.value is same as(oTopCont.oxcontents__oxloadid.value) %} aria-current="page"{% endif %} href="{{ oTopCont.getLink()|raw }}">{{ oTopCont.oxcontents__oxtitle.value}}</a>
                                            </div>
                                        {% endfor %}

                                        <div class="nav-item{% if ocat.getHasVisibleSubCats() %} has-subs{% endif %}">
                                            <a class="nav-link nav-link-1{% if homeNotSelected and ocat.expanded %} active{% endif %}{% if oViewConf.getActCatId() == ocat.getId() %} fw-bold{% endif %}"{% if homeNotSelected and ocat.expanded %} aria-current="page"{% endif %} href="{{ ocat.getLink()|raw }}">
                                                {{ ocat.oxcategories__oxtitle.value }}
                                            </a>

                                            {# LEVEL 2 #}
                                            {% if ocat.getHasVisibleSubCats() %}
                                                <div class="nav-level-2">
                                                    <div class="container-xxl">
                                                        <div class="row">
                                                            <div class="col-lg-4">
                                                                {% for subcatkey, osubcat in ocat.getSubCats() %}
                                                                    {% if osubcat.getIsVisible() %}
                                                                        {% for ocont in osubcat.getContentCats() %}
                                                                            <div class="nav-item nav-item-2">
                                                                                <a class="nav-link{% if oViewConf.getContentId() == ocont.getId() %} active{% endif %}" href="{{ ocont.getLink()|raw }}">{{ ocont.oxcontents__oxtitle.value }}</a>
                                                                            </div>
                                                                        {% endfor %}

                                                                        {% if osubcat.getIsVisible() %}
                                                                            <div class="nav-item nav-item-2">
                                                                                <a class="nav-link{% if homeNotSelected and osubcat.expanded %} active{% endif %}{% if oViewConf.getActCatId() == osubcat.getId() %} fw-bold{% endif %}" href="{{ osubcat.getLink()|raw }}">
                                                                                    <svg class="icon">
                                                                                        <use xlink:href="#{% if homeNotSelected and osubcat.expanded and osubcat.getHasVisibleSubCats() %}down{% else %}right{% endif %}"></use>
                                                                                    </svg>
                                                                                    {{ osubcat.oxcategories__oxtitle.value }}
                                                                                </a>

                                                                                {# LEVEL 3 #}
                                                                                {% if osubcat.getHasVisibleSubCats() %}
                                                                                    <div class="nav-level-3">
                                                                                        {% for subsubcatkey, osubsubcat in osubcat.getSubCats() %}
                                                                                            {% if osubsubcat.getIsVisible() %}
                                                                                                {% for ocont in osubsubcat.getContentCats() %}
                                                                                                    <div class="nav-item">
                                                                                                        <a class="nav-link{% if oViewConf.getContentId() == ocont.getId() %} active{% endif %}" href="{{ ocont.getLink()|raw }}">{{ ocont.oxcontents__oxtitle.value }}</a>
                                                                                                    </div>
                                                                                                {% endfor %}

                                                                                                {% if osubsubcat.getIsVisible() %}
                                                                                                    <div class="nav-item">
                                                                                                        <a class="nav-link{% if homeNotSelected and osubsubcat.expanded %} active{% endif %}{% if oViewConf.getActCatId() == osubsubcat.getId() %} fw-bold{% endif %}{% if not osubsubcat.getHasVisibleSubCats() %} last{% endif %}" href="{{ osubsubcat.getLink()|raw }}">
                                                                                                            {% if osubsubcat.getHasVisibleSubCats() %}
                                                                                                            <svg class="icon">
                                                                                                                <use xlink:href="#{% if homeNotSelected and osubsubcat.expanded %}down{% else %}right{% endif %}"></use>
                                                                                                            </svg>
                                                                                                            {% endif %}
                                                                                                            {{ osubsubcat.oxcategories__oxtitle.value }}
                                                                                                        </a>

                                                                                                        {# LEVEL 4 #}
                                                                                                        {% if osubsubcat.getHasVisibleSubCats() %}
                                                                                                            <div class="nav-level-4">
                                                                                                                {% for subsubsubcatkey, osubsubsubcat in osubsubcat.getHasVisibleSubCats() %}
                                                                                                                    {% if osubsubsubcat.getIsVisible() %}
                                                                                                                        {% for ocont in osubsubsubcat.getContentCats() %}
                                                                                                                            <div class="nav-item">
                                                                                                                                <a class="nav-link{% if oViewConf.getContentId() == ocont.getId() %} active{% endif %}" href="{{ ocont.getLink()|raw }}">{{ ocont.oxcontents__oxtitle.value }}</a>
                                                                                                                            </div>
                                                                                                                        {% endfor %}

                                                                                                                        {% if osubsubsubcat.getIsVisible() %}
                                                                                                                            <div class="nav-item">
                                                                                                                                <a class="nav-link{% if homeNotSelected and osubsubsubcat.expanded %} active{% endif %}{% if oViewConf.getActCatId() == osubsubsubcat.getId() %} fw-bold{% endif %}{% if not osubsubsubcat.getHasVisibleSubCats() %} last{% endif %}" href="{{ osubsubsubcat.getLink()|raw }}">{{ osubsubsubcat.oxcategories__oxtitle.value }}</a>
                                                                                                                            </div>
                                                                                                                        {% endif %}
                                                                                                                    {% endif %}
                                                                                                                {% endfor %}
                                                                                                            </div>
                                                                                                        {% endif %}
                                                                                                    </div>
                                                                                                {% endif %}
                                                                                            {% endif %}
                                                                                        {% endfor %}
                                                                                    </div>
                                                                                {% endif %}
                                                                            </div>
                                                                        {% endif %}
                                                                    {% endif %}
                                                                {% endfor %}
                                                            </div>
                                                            <div class="col-md-8 d-none d-lg-block">
                                                                {# Content #}
                                                                {% include_content 'oxstartslot1' ignore missing  %}
                                                                {% block dd_widget_header_categorylist_content %}{% endblock %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            {% endblock %}
                        </div>
                        <div class="col-sm-12 col-md-6 mt-3 d-md-block d-lg-none">
                            {% include_content 'oxstartslot1' ignore missing  %}
                        </div>
                    </div>
                {% endblock %}
            </nav>
        </div>
    {% endif %}
{% endblock %}
