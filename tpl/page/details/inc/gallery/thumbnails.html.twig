{% set carouselId = carouselId|default('productGalleryCarousel') %}
{% set mediaItems = mediaItems|default(oView.getMediaItems()) %}

{% if mediaItems|length > 1 %}
    <div class="carousel-indicators thumbnails">
        {% for mediaItem in mediaItems %}
            <button type="button"
                    class="thumb{% if loop.first %} active{% endif %}"
                    data-bs-target="#{{ carouselId }}"
                    data-bs-slide-to="{{ loop.index0 }}"
                    {% if loop.first %}aria-current="true"{% endif %}
                    aria-label="{{ mediaItem.attributes.has('alt') ? mediaItem.attributes.alt : '' }}">
                <img loading="lazy"
                     src="{{ mediaItem.getIconUrl()|raw }}"
                     alt="{{ mediaItem.attributes.has('alt') ? mediaItem.attributes.alt : '' }}"
                     width="112"
                     height="112">
            </button>
        {% endfor %}
    </div>
{% endif %}
