{{ script({ include: "js/pages/details/hoverzoom.min.js", priority: 11, dynamic: __oxid_include_dynamic }) }}

<div class="wrap">
    {% for mediaItem in oView.getMediaItems() %}
        <figure class="zoom-container-hover">
            <img src="{{ mediaItem.getZoomUrl()|raw }}" alt="{{ translate({ ident: "PRODUCT_GALLERY_IMAGE_ALT", args: { "count": iPicNr, "title": oPictureProduct.oxarticles__oxtitle.value|striptags ~ ' ' ~ oPictureProduct.oxarticles__oxvarselect.value|striptags } }) }}">
        </figure>
    {% endfor %}
</div>
