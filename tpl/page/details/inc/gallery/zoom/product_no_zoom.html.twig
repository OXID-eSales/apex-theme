{% set mediaItems = mediaItems|default(oView.getMediaItems()) %}

<div class="carousel-inner">
    {% for mediaItem in mediaItems %}
        <div class="carousel-item{% if loop.first %} active{% endif %}">
            <figure>
                <img src="{{ mediaItem.getZoomUrl()|raw }}"
                     alt="{{ mediaItem.getAlt(oDetailsProduct.getTitle()) }}"/>
            </figure>
        </div>
    {% endfor %}
</div>
