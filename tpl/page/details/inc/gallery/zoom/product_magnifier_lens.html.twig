{{ script({ include: "js/pages/details/magnifierlens.min.js", priority: 10, dynamic: __oxid_include_dynamic }) }}

{% set mediaItems = mediaItems|default(oView.getMediaItems()) %}

<div class="carousel-inner overflow-visible">
    {% for mediaItem in mediaItems %}
        <div class="carousel-item{% if loop.first %} active{% endif %}">
            <figure class="zoom-container-magnifier">
                <img src="{{ mediaItem.getZoomUrl()|raw }}"
                     alt="{{ mediaItem.getAlt(oDetailsProduct.getTitle()) }}">
                <div class="lens"></div>
                <div class="zoom-result-magnifier">
                    <img src="" alt="Magnified image">
                </div>
            </figure>
        </div>
    {% endfor %}
</div>
