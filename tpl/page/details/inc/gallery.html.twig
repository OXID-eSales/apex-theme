{% block details_productmain_gallery %}
{% set imageCount = oView.getMediaItems()|length %}

<div class="gallery">
    <div class="carousel">
        {% for mediaItem in oView.getMediaItems() %}
            <input type="radio" class="gallery-helper" id="image{{ loop.index }}" name="gallery-control"{% if loop.first %} checked{% endif %} />
        {% endfor %}

        {% block details_productmain_gallery_thumbnails_main %}
            {% include "page/details/inc/gallery/thumbnails.html.twig" %}
        {% endblock %}

        {% block details_productmain_gallery_sliders_main %}
            {% include "page/details/inc/gallery/sliders.html.twig" %}
        {% endblock %}
    </div>
</div>
{% endblock %}
