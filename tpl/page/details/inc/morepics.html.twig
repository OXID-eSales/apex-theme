{% if oView.hasMultipleImages() %}
    {% set mediaItems = oView.getMediaItems() %}
    {% set mediaCount = mediaItems|length %}

    <div class="details-picture-more{% if mediaCount > 4 %} flexslider{% endif %}" id="morePicsContainer">
        <ul class="{% if mediaCount > 4 %}slides{% else %}details-picture-more-list{% endif %}">
            {% for mediaItem in mediaItems %}
                <li class="details-picture-more-list-item">
                    <a id="morePics_{{ loop.index }}" data-zoom-url="{{ mediaItem.getZoomUrl()|raw }}">
                        <img class="details-picture-more-img" src="{{ mediaItem.getIconUrl()|raw }}" alt="{{ mediaItem.attributes.has('alt') ? mediaItem.attributes.alt : '' }}">
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
